  "findings": [
    {
      "id": "FIND-001",
      "title": "Campus publishes a Privacy and Security Notice as the public tracking baseline",
      "claim_grade": "Documented",
      "severity": "S1",
      "likelihood": "L3",
      "summary": "CSUSB publishes a Privacy and Security Notice describing how the public website handles information. This is the baseline against which portal and vendor behavior should be compared; gaps between notice language and LMS/SIS practice are in-scope for later findings.",
      "evidence_ids": [
        "SRC-www-csusb-edu-about-csusb-privacy-and-se-afc6f4d7"
      ],
      "student_action": "Read the Privacy and Security Notice, then compare cookie and third-party requests on login portals using the self-audit toolkit.",
      "school_action": "Keep the notice synchronized with actual LMS, SIS, and vendor tracking.",
      "status": "open"
    },
    {
      "id": "FIND-002",
      "title": "FERPA policy is published as a campus policy page",
      "claim_grade": "Documented",
      "severity": "S0",
      "likelihood": "L3",
      "summary": "CSUSB publishes a Family Educational Rights and Privacy Act policy page. Presence of policy is not proof of operational compliance; it is the stated rights baseline for the case file.",
      "evidence_ids": [
        "SRC-www-csusb-edu-policies-family-educationa-19175d4f"
      ],
      "student_action": "Read FERPA rights on the campus policy page and note how to request records.",
      "school_action": "Ensure LMS/vendor practices are consistent with published FERPA policy.",
      "status": "open"
    },
    {
      "id": "FIND-003",
      "title": "Student records administration policy is a separate public control document",
      "claim_grade": "Documented",
      "severity": "S1",
      "likelihood": "L3",
      "summary": "A distinct Student Records Administration policy exists alongside FERPA. Fragmented policy surfaces increase the risk that students only see marketing privacy language and miss records controls.",
      "evidence_ids": [
        "SRC-www-csusb-edu-policies-university-policy-2393e730"
      ],
      "student_action": "Locate both FERPA and student-records policies before signing third-party education app prompts.",
      "school_action": "Cross-link records, FERPA, and privacy notice pages from login and LMS footers.",
      "status": "open"
    },
    {
      "id": "FIND-004",
      "title": "Information Security policies are published but product/vendor inventory is not obvious from the landing page",
      "claim_grade": "Documented",
      "severity": "S2",
      "likelihood": "L2",
      "summary": "The information-security policies index is public, yet a clear student-facing inventory of EdTech vendors and data categories is not apparent from the landing page alone. Opacity about processors is an abuse-risk signal even when security policy text exists.",
      "evidence_ids": [
        "SRC-www-csusb-edu-policies-information-secur-ce9288e2",
        "SRC-www-csusb-edu-its-9ecfcbb7"
      ],
      "student_action": "Ask ITS/registrar which vendors receive directory or education-record data for each portal you use.",
      "school_action": "Publish a maintained student-data processor list with purposes and retention.",
      "status": "open"
    },
    {
      "id": "FIND-005",
      "title": "Public ITS services directory is a starting map for data-holding systems",
      "claim_grade": "Documented",
      "severity": "S0",
      "likelihood": "L3",
      "summary": "ITS publishes a services directory that helps enumerate systems that may process student data. This supports the project inventory task without unauthorized probing.",
      "evidence_ids": [
        "SRC-www-csusb-edu-its-services-efb31b69"
      ],
      "student_action": "Use the ITS services list when filling the self-audit toolkit system inventory.",
      "school_action": "Annotate each service with data categories and vendor names.",
      "status": "open"
    },
    {
      "id": "FIND-006",
      "title": "Public website uses Google Analytics and discloses cookies / clear gifs",
      "claim_grade": "Documented",
      "severity": "S2",
      "likelihood": "L3",
      "summary": "CSUSB's Privacy and Security Notice states the Sites use Google Analytics and use cookies, clear gifs, and log files for remembering information, monitoring effectiveness, and related purposes. Clear gifs are described as tracking usage patterns anonymously and email open behavior. This is first-party public admission of cross-request tracking on the public web surface.",
      "evidence_ids": [
        "SRC-www-csusb-edu-about-csusb-privacy-and-se-afc6f4d7"
      ],
      "student_action": "Use browser tracker controls on csusb.edu; compare LMS/SIS third parties in a separate own-account audit.",
      "school_action": "Publish a current cookie/tracker table and whether analytics applies inside authenticated portals.",
      "status": "open"
    },
    {
      "id": "FIND-007",
      "title": "Privacy Notice scope excludes employee HR data and may not cover LMS vendor ecosystems clearly",
      "claim_grade": "Documented",
      "severity": "S2",
      "likelihood": "L3",
      "summary": "The Privacy and Security Notice applies to www.csusb.edu and other Sites that link to the Notice. It explicitly does not apply to information collected about workers as part of employment. Students reading only this Notice can reasonably miss that Canvas, myCoyote, and learning-app vendors operate under separate regimes -- a policy-theater risk relative to the lived student stack.",
      "evidence_ids": [
        "SRC-www-csusb-edu-about-csusb-privacy-and-se-afc6f4d7",
        "SRC-www-csusb-edu-canvas-fe4f6ffe"
      ],
      "student_action": "Treat the web Privacy Notice as incomplete for course/LMS data; also read FERPA/records policies and Canvas app notices.",
