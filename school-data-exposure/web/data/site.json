    {
      "id": "FIND-008",
      "title": "University discloses sharing personal data with vendors including education management and marketing",
      "claim_grade": "Documented",
      "severity": "S3",
      "likelihood": "L3",
      "summary": "The Privacy and Security Notice states the University engages processors for purposes such as marketing, application processing, financial aid or payment processing, education management, and web hosting, and may share personal data with government agencies as required. Vendor categories are named; a student-facing processor inventory is not.",
      "evidence_ids": [
        "SRC-www-csusb-edu-about-csusb-privacy-and-se-afc6f4d7"
      ],
      "student_action": "Request the current processor list via records request after DI-12.",
      "school_action": "Publish named processors, purposes, and retention beside the Notice.",
      "status": "open"
    },
    {
      "id": "FIND-009",
      "title": "Canvas (Instructure) is the campus LMS with SAML login",
      "claim_grade": "Documented",
      "severity": "S1",
      "likelihood": "L3",
      "summary": "CSUSB publishes Canvas resources and links to https://csusb.instructure.com/login/saml. Course activity, grades-adjacent workflows, and learning-app launches concentrate here -- a primary student-data plane for the investigation.",
      "evidence_ids": [
        "SRC-www-csusb-edu-canvas-fe4f6ffe"
      ],
      "student_action": "Include Canvas in every self-audit; review installed course apps before launching them.",
      "school_action": "Publish Canvas data categories, retention, and approved learning-app inventory with DPAs.",
      "status": "open"
    },
    {
      "id": "FIND-010",
      "title": "Canvas Learning Apps catalog includes Turnitin and Respondus LockDown Browser/Monitor webcam proctoring",
      "claim_grade": "Documented",
      "severity": "S3",
      "likelihood": "L3",
      "summary": "The public Canvas Learning Apps page describes Turnitin (integrity/plagiarism/grading) and Respondus LockDown Browser and Monitor, which locks the test environment and uses the student's webcam for auto-proctoring. Webcam proctoring is a high-sensitivity surveillance capability sitting inside the LMS app ecosystem.",
      "evidence_ids": [
        "SRC-www-csusb-edu-canvas-instructor-resource-cb6e66b7"
      ],
      "student_action": "Before a proctored exam, demand written notice of what is recorded, retained, and who can review it.",
      "school_action": "Require course-level notice, retention limits, and alternatives when biometric/webcam monitoring is used.",
      "status": "open"
    },
    {
      "id": "FIND-011",
      "title": "Identity stack publicly includes myCoyote portal and DUO multi-factor authentication",
      "claim_grade": "Documented",
      "severity": "S1",
      "likelihood": "L3",
      "summary": "ITS publishes About myCoyote, portal/mobile app guides, and DUO MFA requirements/setup. Campus identity therefore binds students across portal services under MFA -- increasing both security and cross-system linkage of activity.",
      "evidence_ids": [
        "SRC-www-csusb-edu-its-support-technology-sup-9a96819c",
        "SRC-www-csusb-edu-its-services-portal-and-mo-a6336b2f",
        "SRC-www-csusb-edu-its-security-identity-acce-1861db83"
      ],
      "student_action": "Map which apps appear under myCoyote after login (own account) and note unexpected third parties.",
      "school_action": "Publish the SSO attribute release matrix for major apps.",
      "status": "open"
    },
    {
      "id": "FIND-012",
      "title": "Canvas login hands the browser to Instructure Identity / Canvas SSO hosts",
      "claim_grade": "Documented",
      "severity": "S2",
      "likelihood": "L3",
      "summary": "An unauthenticated request to https://csusb.instructure.com/login/saml redirects into Instructure-hosted identity infrastructure (*.login.instructure.com) with callback involvement of sso.canvaslms.com. Student authentication for coursework therefore begins on vendor-controlled domains, not csusb.edu. Transient OAuth/JWT query parameters were redacted from stored evidence.",
      "evidence_ids": [
        "SRC-csusb-instructure-com-login-saml-01aa4673"
      ],
      "student_action": "Expect campus credentials to be checked in a vendor identity flow; review browser address bar before entering passwords.",
      "school_action": "Publish a plain-language SSO hop diagram naming every domain in the login chain.",
      "status": "open"
    },
    {
      "id": "FIND-013",
      "title": "Respondus publishes separate Monitor student terms and processes student/examinee personal information",
      "claim_grade": "Documented",
      "severity": "S3",
      "likelihood": "L3",
      "summary": "Respondus's public privacy policy covers services to institutions and distinguishes Students (including examinees/test takers) from instructors. It references Respondus Monitor institution and student terms of use. Combined with CSUSB listing Respondus Monitor on Canvas Learning Apps, this documents a vendor privacy regime for proctoring-capable software beyond the campus website Privacy Notice.",
      "evidence_ids": [
        "SRC-web-respondus-com-privacy-policy-767d5699",
        "SRC-www-csusb-edu-canvas-instructor-resource-cb6e66b7"
      ],
      "student_action": "Read Respondus Monitor student terms before any webcam exam; ask the instructor what is recorded and retained.",
      "school_action": "Link Respondus Monitor student terms from course syllabi when Monitor is required.",
      "status": "open"
    },
    {
      "id": "FIND-014",
      "title": "Instructure product privacy applies when schools use Canvas products",
      "claim_grade": "Documented",
      "severity": "S1",
      "likelihood": "L3",
      "summary": "Instructure's Product Privacy policy describes processing for academic institutions using its products, states it does not sell or rent personal information to third parties, and discusses cookies/similar tech and professional information categories. CSUSB's Canvas deployment therefore sits under both campus notices and Instructure's product privacy regime.",
